# 改成你的模型名称
MODEL=qwen/qwen3-8b
# 通常来说都是openai
MODEL_PROVIDER=openai
# 这是我本地部署的，你用什么的就改成什么的 比如deepseek可以去官网看
BASE_URL=http://localhost:1234/v1
# 密钥
API_KEY=1234
# 嵌入模型文件夹
EMB_DIR_PATH=D:\home\models\BAAI
# 嵌入模型名称
EMB_MODEL_NAME=bge-small-zh-v1.5
# 嵌入模型使用设备
EMB_DEVICE=cpu
# RERANKER模型文件夹
RERANKER_DIR_PATH=D:\home\models\BAAI
# RERANKER模型文件夹
RERANKER_MODEL_NAME=bge-reranker-v2-m3
# RERANKER模型使用设备
RERANKER_DEVICE=cpu
